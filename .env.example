# --- dataset build (translation + augmentation) ---
GEMINI_API_KEY=
# optional: override the Gemini model (default gemini-2.5-flash)
GEMINI_MODEL=
ADAPTION_API_KEY=

# --- monitor models (run_monitors.py --models ...) ---
# DeepSeek is the default monitor model and is required for the default run.
DEEPSEEK_API_KEY=
# optional overrides:
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Add these to bring Claude / GPT online as additional monitor models
# (Phase 1 #3 — `python src/run_monitors.py --models deepseek claude gpt`).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
