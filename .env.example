# Copy to .env and fill in. KEY NAMES only — never commit .env.
# Names must match exactly — each SDK reads its own:
ANTHROPIC_API_KEY=     # Oracle + a Monitor (anthropic)
OPENAI_API_KEY=        # a Monitor (openai)
GEMINI_API_KEY=        # Attacker + a Monitor (google-genai; GOOGLE_API_KEY also works)
DEEPSEEK_API_KEY=      # Executor + a Monitor (deepseek, via openai client)
